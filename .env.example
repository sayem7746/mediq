# Copy to .env.local for development. Never commit real secrets.
NODE_ENV=development
DATABASE_PATH=./data/mediq.sqlite
SESSION_SECRET=replace-with-at-least-32-characters
STAFF_BOOTSTRAP_EMAIL=staff@example.com
STAFF_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ANALYTICS_ENABLED=false
GENERAL_LAUNCH_ENABLED=false
# Set to 1 only for local/demo fixture listings. Leave unset in production.
# TEST_FIXTURES=1
